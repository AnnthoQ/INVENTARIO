# Copia este archivo como .env (junto al ejecutable o en la carpeta del proyecto).

# Supabase → Project Settings → API
SUPABASE_URL=https://pvgdkcadqakfercyguhd.supabase.co
# Clave publishable (sb_publishable_…) o anon. NUNCA la service_role / secret:
# la aplicación se niega a arrancar con ella.
SUPABASE_KEY=

# Dominio de los usuarios con código: «op01» inicia sesión como op01@inv.local
INVENTARIO_DOMINIO_CODIGOS=inv.local

# Minutos sin actividad antes de bloquear la pantalla
INVENTARIO_MINUTOS_INACTIVIDAD=15

# Cada cuántos segundos se comprueba que la cuenta siga activa (mínimo 30)
INVENTARIO_SEGUNDOS_VERIFICACION_SESION=120

# Permitir la casilla «Recordar sesión en este equipo» (true/false)
INVENTARIO_RECORDAR_SESION=true
